# ============================================================================
# Solar environment configuration
# Copy to .env.local for local dev, and set the same keys in Vercel /
# Render project env. NEVER commit real secrets.
# ============================================================================

# === Supabase =================================================================
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-publishable-anon-key>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-anon-key>
SUPABASE_SECRET_KEY=<supabase-secret-service-role-key>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Only needed if applying migrations via the Supabase CLI/psql.
SUPABASE_DB_PASS=<supabase-database-password>

# === Anthropic ================================================================
AI_API_KEY=sk-ant-...
AI_MODEL_NAME=claude-haiku-4-5

# === Armoriq intent guardrails (optional — fails open) ========================
ARMORIQ_API_KEY=ak_live_...
ARMORIQ_USER_EMAIL=you@example.com

# === Cron shared secret =======================================================
# Used by the Render cron jobs to call:
#   GET/POST /api/github/poll   (header x-cron-secret or ?secret=)
#   GET/POST /api/cron/reaper   (header x-cron-secret or ?secret=)
# Must be IDENTICAL in the Vercel app env and every Render cron job env.
CRON_SECRET=solar_cron_sec_<random-hex>

# === Tensorlake sandboxes =====================================================
TENSORLAKE_API_KEY=tl_apiKey_...
TENSORLAKE_MOCK=false

# === Web search (Exa, optional) ===============================================
EXA_API_KEY=...
